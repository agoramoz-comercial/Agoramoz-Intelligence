# --- Base de dados ----------------------------------------------------------
# Ligação da aplicação: papel SEM privilégios de owner/superuser (RLS aplica-se).
DATABASE_URL=postgres://agoramoz_app:agoramoz_app_dev@127.0.0.1:5432/agoramoz_hr
# Ligação administrativa: owner do schema, usada só por migrações, seed e worker.
DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:5432/agoramoz_hr

# --- Aplicação ---------------------------------------------------------------
APP_URL=http://localhost:3000
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-64-hex-chars
STORAGE_DIR=./storage

# --- Email (P0) --------------------------------------------------------------
# "log" guarda as mensagens na caixa de desenvolvimento; "smtp" envia de facto.
EMAIL_PROVIDER=log
SMTP_URL=
EMAIL_FROM="AGORAMOZ HR <no-reply@example.org>"

# --- IA assistiva (E9, desligada por defeito) --------------------------------
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Página comercial -----------------------------------------------------
# Email que recebe os pedidos de piloto (sem valor, o botão abre https://agoramoz.com/mz).
CONTACT_EMAIL=
